def ejecutar_gurobi():

    print(
        "=" * 70
    )

    print(
        "EJECUTANDO MODELO GUROBI"
    )

    print(
        "=" * 70
    )

    print()


    # ========================================================
    # COMPROBAR MODELO
    # ========================================================

    if not os.path.exists(
        MODELO_GUROBI
    ):

        raise FileNotFoundError(

            "No se encontro el modelo Gurobi:\n"

            f"{MODELO_GUROBI}"

        )


    # ========================================================
    # COMPROBAR ARCHIVO SOLAR
    # ========================================================

    if not os.path.exists(
        ARCHIVO_SOLAR
    ):

        raise FileNotFoundError(

            "No se encontro:\n"

            f"{ARCHIVO_SOLAR}"

        )


    # ========================================================
    # EJECUTAR MODELO ORIGINAL
    # ========================================================

    # runpy ejecuta el modelo completo
    # desde cero.
    #
    # Esto es importante porque cada coordenada
    # debe tener una optimizacion independiente.

    resultados = runpy.run_path(

        MODELO_GUROBI,

        run_name="__main__"

    )


    return resultados


