def crear_solar_inc(
    perfil
):

    print(
        "=" * 70
    )

    print(
        "GENERANDO solar_colombia.inc"
    )

    print(
        "=" * 70
    )

    print()


    # ========================================================
    # COMPROBAR 8760 VALORES
    # ========================================================

    if len(perfil) != 8760:

        raise RuntimeError(

            "El perfil solar no contiene "
            "exactamente 8760 valores."

        )


    # ========================================================
    # ESCRIBIR ARCHIVO
    # ========================================================

    with open(

        ARCHIVO_SOLAR,

        "w",

        encoding="utf-8"

    ) as archivo:


        for i, valor in enumerate(

            perfil,

            start=1

        ):

            archivo.write(

                f"t{i} {valor:.4f}\n"

            )


    print(
        "Archivo generado:"
    )

    print(
        ARCHIVO_SOLAR
    )

    print()


    print(
        "Valores escritos:",
        len(perfil)
    )

    print()


