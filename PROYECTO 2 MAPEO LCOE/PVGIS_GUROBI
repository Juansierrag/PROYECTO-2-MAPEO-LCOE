# ============================================================
# 3. FUNCION PVGIS
# ============================================================

def obtener_perfil_pvgis(
    latitud,
    longitud
):

    print()
    print("=" * 70)
    print("GENERADOR DE PERFIL SOLAR PVGIS")
    print("=" * 70)
    print()

    print("Latitud :", latitud)
    print("Longitud:", longitud)
    print()


    # ========================================================
    # CONFIGURACION PVGIS
    # ========================================================

    url = (
        "https://re.jrc.ec.europa.eu/api/v5_2/seriescalc"
    )


    params = {

        # Coordenadas
        "lat": latitud,
        "lon": longitud,

        # Periodo PVGIS / NSRDB
        "startyear": 2005,
        "endyear": 2015,

        # Calculo de potencia FV
        "pvcalculation": 1,

        # Sistema de referencia de 1 kWp
        "peakpower": 1,

        # Tecnologia
        "pvtechchoice": "crystSi",

        # Montaje
        "mountingplace": "free",

        # Perdidas
        "loss": 14,

        # Inclinacion
        "angle": 10,

        # Orientacion
        # 0 = Sur
        "aspect": 0,

        # Hora local
        "localtime": 1,

        # Formato
        "outputformat": "json"

    }


    # ========================================================
    # CONECTAR CON PVGIS
    # ========================================================

    print(
        "Conectando con PVGIS..."
    )

    print()


    try:

        respuesta = requests.get(

            url,

            params=params,

            timeout=120

        )


    except requests.exceptions.RequestException as error:

        raise RuntimeError(

            "ERROR DE CONEXION CON PVGIS:\n"
            f"{error}"

        )


    # ========================================================
    # COMPROBAR RESPUESTA
    # ========================================================

    if respuesta.status_code != 200:

        raise RuntimeError(

            "PVGIS no pudo realizar la consulta.\n\n"

            f"Codigo HTTP: "
            f"{respuesta.status_code}\n\n"

            f"{respuesta.text}"

        )


    print(
        "Conexion con PVGIS exitosa."
    )

    print()


    # ========================================================
    # LEER JSON
    # ========================================================

    try:

        datos = (
            respuesta.json()
        )


    except ValueError:

        raise RuntimeError(

            "PVGIS no devolvio un JSON valido."

        )


    # ========================================================
    # EXTRAER SERIE HORARIA
    # ========================================================

    try:

        series_horarias = (
            datos[
                "outputs"
            ][
                "hourly"
            ]
        )


    except KeyError:

        raise RuntimeError(

            "No se encontro la serie horaria "
            "en PVGIS."

        )


    df = pd.DataFrame(
        series_horarias
    )


    print(
        "Datos recibidos desde PVGIS."
    )

    print(
        "Cantidad de registros:",
        len(df)
    )

    print()


    # ========================================================
    # CONVERTIR FECHA
    # ========================================================

    # Formato de PVGIS:
    #
    # YYYYMMDD:HHMM
    #
    # Ejemplo:
    #
    # 20050101:1700

    df["fecha"] = pd.to_datetime(

        df["time"],

        format="%Y%m%d:%H%M"

    )


    # ========================================================
    # CORRECCION HORARIA
    # ========================================================

    # PVGIS entrega los timestamps en UTC.
    #
    # Colombia = UTC - 5
    #
    # Por lo tanto:
    #
    # hora Colombia =
    # hora PVGIS - 5 horas

    df["fecha"] = (

        df["fecha"]

        - pd.Timedelta(
            hours=5
        )

    )


    # ========================================================
    # EXTRAER MES, DIA Y HORA
    # ========================================================

    df["mes"] = (
        df["fecha"].dt.month
    )

    df["dia"] = (
        df["fecha"].dt.day
    )

    df["hora"] = (
        df["fecha"].dt.hour
    )


    # ========================================================
    # POTENCIA FV NORMALIZADA
    # ========================================================

    # PVGIS entrega P en Watts.
    #
    # peakpower = 1 kWp
    #
    # Por lo tanto:
    #
    # perfil = P / 1000
    #
    # El perfil queda normalizado aproximadamente
    # entre 0 y 1.

    df["perfil"] = (
        df["P"] / 1000.0
    )


    # ========================================================
    # ELIMINAR 29 DE FEBRERO
    # ========================================================

    # El modelo Gurobi necesita:
    #
    # 365 dias x 24 horas
    #
    # = 8760 horas

    df = df[
        ~(
            (df["mes"] == 2)
            &
            (df["dia"] == 29)
        )
    ].copy()


    # ========================================================
    # PROMEDIO MULTIANUAL
    # ========================================================

    # Se calcula un promedio para cada:
    #
    # mes
    # dia
    # hora
    #
    # utilizando todos los años 2005-2015.

    perfil = (

        df

        .groupby(
            [
                "mes",
                "dia",
                "hora"
            ]
        )["perfil"]

        .mean()

        .reset_index()

    )


    # ========================================================
    # ORDEN CRONOLOGICO
    # ========================================================

    perfil = (

        perfil

        .sort_values(
            [
                "mes",
                "dia",
                "hora"
            ]
        )

        .reset_index(
            drop=True
        )

    )


    # ========================================================
    # COMPROBAR 8760 HORAS
    # ========================================================

    cantidad_horas = (
        len(perfil)
    )


    print(
        "=" * 70
    )

    print(
        "VERIFICACION DEL PERFIL"
    )

    print(
        "=" * 70
    )

    print()


    print(
        "Cantidad de horas:",
        cantidad_horas
    )

    print()


    if cantidad_horas != 8760:

        raise RuntimeError(

            f"El perfil contiene "
            f"{cantidad_horas} horas. "

            "Se esperaban 8760."

        )


    # ========================================================
    # ELIMINAR PEQUENOS VALORES NEGATIVOS
    # ========================================================

    perfil["perfil"] = (

        perfil["perfil"]

        .clip(
            lower=0
        )

    )


    # ========================================================
    # ESTADISTICAS
    # ========================================================

    print(

        "Potencia minima:",

        f"{perfil['perfil'].min():.4f}"

    )


    print(

        "Potencia maxima:",

        f"{perfil['perfil'].max():.4f}"

    )


    print(

        "Potencia promedio:",

        f"{perfil['perfil'].mean():.4f}"

    )


    print()


    # ========================================================
    # DEVOLVER PERFIL
    # ========================================================

    return (
        perfil["perfil"].tolist()
    )


